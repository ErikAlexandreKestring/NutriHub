# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# DB_USER/DB_PASSWORD: dono do schema, usado só para migrations/seeds (precisa
# de privilégio para criar tabelas, roles, extensões).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nutrihub
DB_SSL=false

# DB_APP_USER/DB_APP_PASSWORD: papel sem privilégio de superusuário usado pela
# aplicação em tempo de execução — essencial para o RLS (RN-01) funcionar de
# verdade, já que superusuário ignora RLS (BYPASSRLS). Criado pela migration
# create_app_role. A senha padrão só vale com NODE_ENV development ou test; fora
# deles DB_APP_PASSWORD é obrigatória e a API não sobe sem ela.
DB_APP_USER=nutrihub_app
DB_APP_PASSWORD=nutrihub_app_dev_password

# JWT. Obrigatório fora de development/test: sem ele a API não sobe. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN_NUTRICIONISTA=8h
JWT_EXPIRES_IN_PACIENTE=24h

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Criptografia em repouso dos dados de saúde (RNF-03): 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção (fora dela há uma chave de desenvolvimento). Guarde-a
# fora do banco — sem ela o histórico dos pacientes não pode mais ser lido.
# DATA_ENCRYPTION_KEY=

# Notificações (RF-06 / RF-07)
# NOTIFICATIONS_WORKER=off desliga o worker neste processo.
NOTIFICATIONS_WORKER=on
NOTIFICATIONS_POLL_MS=5000
# Endereço do PWA, usado nos links das mensagens.
APP_URL=http://localhost:5173

# E-mail: console (só escreve no log) | smtp. Padrão: console fora de produção.
EMAIL_TRANSPORT=console
EMAIL_FROM=Nutri-Hub <nao-responda@nutrihub.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Observabilidade: Azure Application Insights. Vazia, a telemetria fica desligada
# (é o caso em desenvolvimento). Em produção vem das configurações do App Service.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
